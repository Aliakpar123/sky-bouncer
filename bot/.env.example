BOT_TOKEN=123456:your-telegram-bot-token
APP_URL=https://your-app-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Leave WEBHOOK_URL unset to run in long-polling mode (fine for local dev).
# Set it (e.g. https://your-bot-host.example/webhook) when deploying to Render/Fly.io.
WEBHOOK_URL=
PORT=8080
